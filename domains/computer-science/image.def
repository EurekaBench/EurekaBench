Bootstrap: docker
From: python:3.12-slim

%arguments
    HF_STAGE=/nonexistent

%files
    {{ HF_STAGE }}/hub /opt/hf/hub

%environment
    export MPLBACKEND=Agg

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git tmux xz-utils
    rm -rf /var/lib/apt/lists/*
    curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1
    npm install -g @anthropic-ai/claude-code @openai/codex
    pip install --no-cache-dir uv
    echo "beartype==0.21.0" > /tmp/overrides.txt
    UV_HTTP_TIMEOUT=600 uv pip install --system --no-cache --override /tmp/overrides.txt \
        "datasets==4.5.0" "fire==0.7.1" "huggingface-hub==0.36.0" \
        "MIB_circuit_track @ git+https://github.com/hannamw/MIB-circuit-track@b759df34433c9e31043ba9e02908ce0bf20e894f" \
        "numpy>=1.26.4,<2.0" "plotly==6.5.1" "pydantic==2.12.5" "PyYAML==6.0.3" "rich==14.2.0" "torch==2.9.1" \
        "transformer-lens==2.17.0" "transformers==4.57.6" "peft>=0.13.0" "scikit-learn" "pandas"
    rm -f /tmp/overrides.txt
    python - <<'PY'
import csv, pathlib, shutil, sysconfig
purelib = pathlib.Path(sysconfig.get_paths()["purelib"])
for info in purelib.glob("mib_circuit_track-*.dist-info"):
    names = {info.name}
    record = info / "RECORD"
    if record.is_file():
        with open(record, newline="") as f:
            names |= {row[0].split("/")[0] for row in csv.reader(f) if row}
    for name in sorted(names):
        if not name or name.startswith("."):
            continue
        target = purelib / name
        if target.is_dir():
            shutil.rmtree(target)
        elif target.exists():
            target.unlink()
        else:
            continue
        print(f"[image] removed {target}")
PY
    EAP_DIR=$(python -c "import eap, os; print(os.path.dirname(eap.__file__))")
    rm -f "${EAP_DIR}/attribute.py" "${EAP_DIR}/attribute_node.py" "${EAP_DIR}/evaluate.py"
    rm -rf "${EAP_DIR}/__pycache__"
    python -c "from eap.graph import Graph; from eap import utils"
    if python -c "import MIB_circuit_track" 2> /dev/null; then
        echo "MIB_circuit_track still importable after uninstall" >&2
        exit 1
    fi
    ln -sf /usr/local/bin/python3 /usr/bin/python3
    python3 -m venv /opt/harbor-server
    /opt/harbor-server/bin/pip install --no-cache-dir uvicorn fastapi asciinema
    ln -sf /opt/harbor-server/bin/asciinema /usr/local/bin/asciinema
    if [ -e /usr/bin/su ]; then mv /usr/bin/su /usr/bin/su.real; fi
    printf '%s\n' '#!/bin/sh' \
        'if [ "$(id -u)" = 0 ] && [ "$1" = root ] && [ "$2" = -s ] && [ "$4" = -c ]; then exec "$3" -c "$5"; fi' \
        'exec /usr/bin/su.real "$@"' > /usr/bin/su
    chmod 755 /usr/bin/su
    mkdir -p /workspace /tests /opt/eurekabench /etc/claude-code
    echo '{}' > /etc/claude-code/managed-settings.json
