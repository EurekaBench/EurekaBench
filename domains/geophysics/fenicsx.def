Bootstrap: docker
From: ghcr.io/fenics/dolfinx/dolfinx:v0.9.0

%environment
    export MPLBACKEND=Agg

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git tmux xz-utils python3-venv
    rm -rf /var/lib/apt/lists/*
    curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1
    npm install -g @anthropic-ai/claude-code @openai/codex
    PY=/dolfinx-env/bin/python
    test -x "${PY}"
    NUMPY_VER=$("${PY}" -c "import numpy; print(numpy.__version__)")
    "${PY}" -m pip install --no-cache-dir "numpy==${NUMPY_VER}" "fire==0.7.1" "scipy>=1.14" "sympy>=1.12" \
        "pydantic==2.12.5" "PyYAML==6.0.3" "rich==14.2.0" pandas "matplotlib>=3.8.0" "scikit-learn>=1.4" \
        "tensorflow-probability>=0.23.0" "optax>=0.1.7" "jax[cuda12]"
    mkdir -p /opt/fenicsx/envs/dolfinx/bin
    printf '#!/bin/sh\nexec %s "$@"\n' "${PY}" > /opt/fenicsx/envs/dolfinx/bin/python
    chmod +x /opt/fenicsx/envs/dolfinx/bin/python
    test -x /usr/bin/python3
    /usr/bin/python3 -m venv /opt/harbor-server
    /opt/harbor-server/bin/pip install --no-cache-dir uvicorn fastapi asciinema
    ln -sf /opt/harbor-server/bin/asciinema /usr/local/bin/asciinema
    if [ -e /usr/bin/su ]; then mv /usr/bin/su /usr/bin/su.real; fi
    printf '%s\n' '#!/bin/sh' \
        'if [ "$(id -u)" = 0 ] && [ "$1" = root ] && [ "$2" = -s ] && [ "$4" = -c ]; then exec "$3" -c "$5"; fi' \
        'exec /usr/bin/su.real "$@"' > /usr/bin/su
    chmod 755 /usr/bin/su
    mkdir -p /workspace /tests /opt/eurekabench /etc/claude-code
    echo '{}' > /etc/claude-code/managed-settings.json
    /opt/fenicsx/envs/dolfinx/bin/python -c "import numpy, ufl, dolfinx, mpi4py, petsc4py; from dolfinx.fem.petsc import LinearProblem; print('dolfinx', dolfinx.__version__)"
    "${PY}" -c "import scipy, sympy, jax, optax, fire; print('agent packages ok')"
    "${PY}" -c "import importlib.util; assert importlib.util.find_spec('diffice_jax') is None, 'diffice_jax leaked into the image'"
